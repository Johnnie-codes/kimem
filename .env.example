# Copy to .env and fill in. All optional; the page works without any of them.
VITE_SITE_URL=https://kimem.com
VITE_CONTACT_EMAIL=hello@kimem.com
VITE_CURRENCY=EUR

# POST endpoint for newsletter sign-ups (field: email)
VITE_NEWSLETTER_URL=

# Checkout hand-off: email | whatsapp | telegram
VITE_ORDER_CHANNEL=email
VITE_ORDER_HANDLE=

VITE_INSTAGRAM_URL=
VITE_PINTEREST_URL=
VITE_TELEGRAM_URL=

# Live batch counter (both needed)
VITE_BATCH_NUMBER=
VITE_BATCH_REMAINING=
